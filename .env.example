# Database
# DATABASE_URL takes precedence over the DB_* settings when set. Managed
# Postgres (e.g. Render) requires TLS; the app adds sslmode=require for URLs
# that do not specify it. Leave empty to use the local compose database.
# Example: postgresql://user:password@host.ohio-postgres.render.com/dbname
DATABASE_URL=

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=res_nam
DB_SSLMODE=disable

# Auth: replace with a long random value before deploying.
JWT_SECRET=change-me

# CORS: set to the deployed frontend origin in production; * is for local dev.
CORS_ORIGIN=*

# KijaniSpace (mock until the live contract is available)
KIJANI_API_KEY=
KIJANI_BASE_URL=
KIJANI_MODE=mock

MIGRATIONS_DIR=migrations

# Host port the frontend is published on.
PORT=8080
