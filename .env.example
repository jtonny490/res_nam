# Database
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=res_nam

# Auth: replace with a long random value before deploying.
JWT_SECRET=change-me

# CORS: set this to the deployed frontend origin, e.g. https://resnam.example.org.
# Use * only for local development.
CORS_ORIGIN=*

# KijaniSpace (mock until the live contract is available)
KIJANI_API_KEY=
KIJANI_BASE_URL=
KIJANI_MODE=mock

MIGRATIONS_DIR=migrations

# Host port the app is published on.
PORT=8080
